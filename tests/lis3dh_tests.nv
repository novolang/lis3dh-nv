// lis3dh_tests — the driver over a double of the part: a register file
// that answers on an I2C bus and on an SPI bus the way ST's data sheet
// (Doc ID 17530 Rev 1, §§ 6.1 and 6.2) says a LIS3DH does, so the sub-
// address and the command byte, the increment, the conversions, the
// FIFO, the self-test and the bring-up are checked on the host, one
// transaction at a time.  The log keeps what the controller sent, in a
// form the tests compare.
//
// Log entries: an I2C write is 1, the address, the bytes sent, -1; an I2C
// read is 2, the address, the sub-address, the count, -1; an SPI
// transaction is 3, the bytes the controller clocked out, -1.

use std.test
use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_id.{ DeviceId, Identifiable }
use lis3dh
use lis3dh.{ Lis3dh, Lis3dhSpi, Lis3dhMode, Lis3dhPort }

// ── The double ───────────────────────────────────────────────────────
//
// `regs` is the part's registers.  `st` is the double's state:
// 0 is 0 before an SPI command byte and 1 after it, 1 the register, 2 RW,
// 3 MS, 4 1 when a part is there, 9 1 inside an SPI transaction, 10 the
// number of FIFO samples taken, 20 and 21 the SPI clock and mode, 22 the
// I2C clock, 30 to 32 the counts the self-test adds to X, Y and Z, 98 the
// bytes in the FIFO and 99 the entries in the log.  `ro` lists registers
// that ignore a write.  `fifo` holds the FIFO's samples as six bytes
// each, and `log` the log.  Everything is kept in maps, which a method
// changes through its receiver.

struct Chip
    regs: HashMap<Int, Int>
    st: HashMap<Int, Int>
    ro: HashMap<Int, Int>
    log: HashMap<Int, Int>
    fifo: HashMap<Int, Int>

fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// The chip with WHO_AM_I and the reset values in place.
fn chip() -> Chip
    let c = Chip { regs: HashMap.new(), st: HashMap.new(), ro: HashMap.new(), log: HashMap.new(), fifo: HashMap.new() }
    c.regs.insert(0x0F, 0x33)
    c.regs.insert(0x20, 0x07)
    c.st.insert(4, 1)
    c

// Appends a value to the log.
fn log_push(c: Chip, v: Int)
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

// Empties the log.
fn log_clear(c: Chip)
    c.st.insert(99, 0)

// The self-test's change to the 16-bit count of axis `axis` (0 X, 1 Y,
// 2 Z): ST 01 adds the part's amount, left-justified, ST 10 subtracts it.
fn st_counts(c: Chip, axis: Int) -> Int
    let st_bits = (at(c.regs, 0x23) >> 1) & 3
    let amount = at(c.st, 30 + axis)
    if st_bits == 1
        return amount * 16
    if st_bits == 2
        return 0 - amount * 16
    0

// The FIFO_SRC_REG the part would read: EMPTY, or the sample count with
// 32 reading as 0.
fn fifo_src(c: Chip) -> Int
    let n = at(c.st, 98) / 6 - at(c.st, 10)
    if n <= 0
        return 0x20
    if n >= 32
        return 0
    n

// Whether the FIFO is on and in a mode other than bypass.
fn fifo_on(c: Chip) -> Bool
    (at(c.regs, 0x24) & 0x40) != 0 and (at(c.regs, 0x2E) >> 6) != 0

// Moves the oldest FIFO sample into the output registers.
fn fifo_pop(c: Chip)
    let head = at(c.st, 10)
    if at(c.st, 98) / 6 - head <= 0
        return
    for i in 0..6
        c.regs.insert(0x28 + i, at(c.fifo, head * 6 + i))
    c.st.insert(10, head + 1)

// A register as the part answers it.
fn chip_read(c: Chip, reg: Int) -> Int
    if reg == 0x2F
        return fifo_src(c)
    if reg == 0x28 and fifo_on(c)
        fifo_pop(c)
    if reg >= 0x28 and reg <= 0x2D
        let axis = (reg - 0x28) / 2
        let lo = 0x28 + axis * 2
        let v = (at(c.regs, lo) | (at(c.regs, lo + 1) << 8)) + st_counts(c, axis)
        if (reg - 0x28) % 2 == 0
            return v & 0xFF
        return (v >> 8) & 0xFF
    at(c.regs, reg)

// A write to a register, which a read-only one ignores; a FIFO put in
// bypass is emptied.
fn chip_write(c: Chip, reg: Int, v: Int)
    if at(c.ro, reg) == 1
        return
    c.regs.insert(reg, v & 0xFF)
    if reg == 0x2E and (v >> 6) == 0
        c.st.insert(10, at(c.st, 98) / 6)

struct FakeI2c
    c: Chip

impl I2cBus for FakeI2c
    fn init(self, freq: Int) [hw]
        self.c.st.insert(22, freq)

    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        log_push(self.c, 1)
        log_push(self.c, addr)
        for b in data
            log_push(self.c, b as Int)
        log_push(self.c, -1)
        if addr != 0x18 or at(self.c.st, 4) == 0 or data.len() < 2
            return false
        let sub = data[0] as Int
        var r = sub & 0x7F
        for i in 1..data.len()
            chip_write(self.c, r, data[i] as Int)
            if (sub & 0x80) != 0
                r = r + 1
        true

    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        None

    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        log_push(self.c, 2)
        log_push(self.c, addr)
        log_push(self.c, tx[0] as Int)
        log_push(self.c, n)
        log_push(self.c, -1)
        if addr != 0x18 or at(self.c.st, 4) == 0
            return None
        let sub = tx[0] as Int
        var r = sub & 0x7F
        var out: [u8] = []
        for _i in 0..n
            list.push(out, chip_read(self.c, r) as u8)
            if (sub & 0x80) != 0
                r = r + 1
        Some(out)

struct FakeSpi
    c: Chip

impl SpiBus for FakeSpi
    fn init(self, freq: Int, mode: Int) [hw]
        self.c.st.insert(20, freq)
        self.c.st.insert(21, mode)

    fn transfer(self, b: Int) -> Int [hw]
        if at(self.c.st, 9) == 1
            log_push(self.c, b)
        if at(self.c.st, 4) == 0
            return 0xFF
        if at(self.c.st, 0) == 0
            self.c.st.insert(0, 1)
            self.c.st.insert(1, b & 0x3F)
            self.c.st.insert(2, (b >> 7) & 1)
            self.c.st.insert(3, (b >> 6) & 1)
            return 0xFF
        let r = at(self.c.st, 1)
        if at(self.c.st, 3) == 1
            self.c.st.insert(1, (r + 1) & 0x3F)
        if at(self.c.st, 2) == 1
            return chip_read(self.c, r)
        chip_write(self.c, r, b)
        0xFF

    fn write(self, data: [u8]) [hw]
        for b in data
            let _ = self.transfer(b as Int)

    fn read(self, n: Int) -> [u8] [hw]
        var out: [u8] = []
        for _i in 0..n
            list.push(out, self.transfer(0xFF) as u8)
        out

// The GPIO double: the chip select (pin 67) falling starts an SPI
// transaction and rising ends it.
struct FakePins
    c: Chip
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)
        if pin == 67 and val == 0
            self.c.st.insert(0, 0)
            self.c.st.insert(9, 1)
            log_push(self.c, 3)
        if pin == 67 and val == 1 and at(self.c.st, 9) == 1
            self.c.st.insert(9, 0)
            log_push(self.c, -1)

    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

fn pins(c: Chip) -> FakePins
    FakePins { c: c, levels: HashMap.new(), modes: HashMap.new() }

// The two ports, as a type that holds a bus implements them: every method
// is the package's own function over the double.
struct I2cDut
    bus: FakeI2c
    pins: FakePins
    w: DeviceWiring

impl Lis3dhPort for I2cDut
    fn setup(self) -> Bool [hw]
        lis3dh.i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        lis3dh.i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        lis3dh.i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        lis3dh.irq_level_of(self.pins, self.w)

struct SpiDut
    bus: FakeSpi
    pins: FakePins
    w: DeviceWiring

impl Lis3dhPort for SpiDut
    fn setup(self) -> Bool [hw]
        lis3dh.spi_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        lis3dh.spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        lis3dh.spi_write(self.bus, self.pins, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        lis3dh.irq_level_of(self.pins, self.w)

// The board's wiring: the part at 0x18 on I2C, INT1 on pin 65.
fn i2c_wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_i2c(0, 0x18), 65)

// The part on SPI: chip select on pin 67, INT1 on pin 65.
fn spi_wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_spi(0, 67), 65)

fn i2c_dut(c: Chip) -> I2cDut
    I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: i2c_wiring() }

fn spi_dut(c: Chip) -> SpiDut
    SpiDut { bus: FakeSpi { c: c }, pins: pins(c), w: spi_wiring() }

// Asserts the log holds exactly `want`, then empties it.
fn log_is(c: Chip, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

fn reg_of(c: Chip, r: Int) -> Int
    at(c.regs, r)

// Sets the 16-bit count of an axis, low byte first, at `reg`.
fn put16(c: Chip, reg: Int, v: Int)
    let u = v & 0xFFFF
    c.regs.insert(reg, u & 0xFF)
    c.regs.insert(reg + 1, u >> 8)

// Sets the three axes to 12-bit high-resolution counts, left-justified.
fn put_hr(c: Chip, x: Int, y: Int, z: Int)
    put16(c, 0x28, x * 16)
    put16(c, 0x2A, y * 16)
    put16(c, 0x2C, z * 16)

// Appends a byte to the FIFO.
fn fifo_put(c: Chip, v: Int)
    let n = at(c.st, 98)
    c.fifo.insert(n, v)
    c.st.insert(98, n + 1)

// A FIFO sample of three 12-bit counts.
fn fifo_push(c: Chip, x: Int, y: Int, z: Int)
    for v in [x * 16, y * 16, z * 16]
        let u = v & 0xFFFF
        fifo_put(c, u & 0xFF)
        fifo_put(c, u >> 8)

fn x_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.x
        None    => -99999

fn y_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.y
        None    => -99999

fn z_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.z
        None    => -99999

// The log of an SPI read: the command, then `n` bytes of 0xFF, which is
// what the controller clocks out while it reads.
fn spi_read_log(cmd: Int, n: Int) -> [Int]
    var out: [Int] = [3, cmd]
    for _i in 0..n
        list.push(out, 0xFF)
    list.push(out, -1)
    out

// ── The two buses' framing ───────────────────────────────────────────

@test
fn test_an_i2c_read_of_one_register_sends_the_bare_sub_address() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lis3dh.reg_read(d, 0x0F) ?? -1, 0x33)
    log_is(c, [2, 0x18, 0x0F, 1, -1])

@test
fn test_an_i2c_read_of_a_run_sets_bit_7_of_the_sub_address() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x28, 11)
    c.regs.insert(0x29, 22)
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x28, 2, var b))
    log_is(c, [2, 0x18, 0xA8, 2, -1])
    test.assert_eq(b[0] as Int, 11)
    test.assert_eq(b[1] as Int, 22)

@test
fn test_an_i2c_write_is_the_register_then_the_byte() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.write_reg(0x20, 0x57))
    log_is(c, [1, 0x18, 0x20, 0x57, -1])
    test.assert_eq(reg_of(c, 0x20), 0x57)

@test
fn test_a_missing_i2c_part_does_not_answer() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(lis3dh.reg_read(d, 0x0F) == None)
    test.assert(not d.write_reg(0x20, 0x57))
    test.assert(not lis3dh.reg_write(d, 0x20, 0x57))
    test.assert(lis3dh.id_read(d) == None)

@test
fn test_an_spi_read_sets_rw_and_one_register_does_not_increment() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert_eq(lis3dh.reg_read(d, 0x0F) ?? -1, 0x33)
    log_is(c, [3, 0x8F, 0xFF, -1])
    test.assert_eq(at(d.pins.levels, 67), 1)

@test
fn test_an_spi_read_of_a_run_sets_rw_and_ms() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    c.regs.insert(0x28, 11)
    c.regs.insert(0x29, 22)
    c.regs.insert(0x2A, 33)
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x28, 3, var b))
    log_is(c, [3, 0xE8, 0xFF, 0xFF, 0xFF, -1])
    test.assert_eq(b[0] as Int, 11)
    test.assert_eq(b[1] as Int, 22)
    test.assert_eq(b[2] as Int, 33)

@test
fn test_an_spi_write_clears_rw_and_ms() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(d.write_reg(0x20, 0x57))
    log_is(c, [3, 0x20, 0x57, -1])
    test.assert_eq(reg_of(c, 0x20), 0x57)

@test
fn test_an_spi_part_that_is_not_there_reads_0xff_and_is_no_part() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = spi_dut(c)
    test.assert_eq(lis3dh.reg_read(d, 0x0F) ?? -1, 0xFF)
    test.assert(lis3dh.id_read(d) == None)
    c.st.insert(4, 1)
    c.regs.insert(0x0F, 0)
    test.assert(lis3dh.id_read(d) == None)

@test
fn test_a_wiring_with_no_chip_select_runs_no_spi_transaction() [io, hw]
    let c = chip()
    let d = SpiDut { bus: FakeSpi { c: c }, pins: pins(c), w: dev_bus.wiring_i2c(0, 0x18) }
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x0F, 1, var b))
    test.assert(not d.write_reg(0x20, 1))
    test.assert(not d.setup())
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_wiring_with_no_address_is_not_an_i2c_part() [io, hw]
    let c = chip()
    let d = I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: dev_bus.wiring_spi(0, 67) }
    test.assert(not d.setup())
    test.assert_eq(at(c.st, 99), 0)

// ── Setup ────────────────────────────────────────────────────────────

@test
fn test_i2c_setup_makes_the_interrupt_pin_an_input_and_the_bus_fast() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.setup())
    test.assert_eq(at(c.st, 22), 400000)
    test.assert_eq(at(d.pins.modes, 65), 0)

@test
fn test_spi_setup_drives_chip_select_high_before_it_is_an_output() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(d.setup())
    test.assert_eq(at(d.pins.levels, 67), 1)
    test.assert_eq(at(d.pins.modes, 67), 1)
    test.assert_eq(at(d.pins.modes, 65), 0)
    test.assert_eq(at(c.st, 20), 4000000)
    test.assert_eq(at(c.st, 21), 3)

@test
fn test_the_interrupt_line_level() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    d.pins.levels.insert(65, 1)
    test.assert_eq(d.irq_level(), 1)
    test.assert_eq(lis3dh.irq_level_of(d.pins, dev_bus.wiring_i2c(0, 0x18)), -1)
    let s = spi_dut(c)
    s.pins.levels.insert(65, 1)
    test.assert_eq(s.irq_level(), 1)

// ── Identity ─────────────────────────────────────────────────────────

@test
fn test_the_identity_is_who_am_i_on_both_buses() [io, hw]
    let c = chip()
    match lis3dh.id_read(i2c_dut(c))
        Some(id) =>
            test.assert_eq(id.who, 0x33)
            test.assert(id.rev == None)
        None => test.assert(false)
    match lis3dh.id_read(spi_dut(c))
        Some(id) => test.assert_eq(id.who, 0x33)
        None     => test.assert(false)

// ── The conversions ──────────────────────────────────────────────────

@test
fn test_the_range_bits_round_trip() [io, hw]
    test.assert(lis3dh.range_of_ctrl4(0x00) == AccelRange2g)
    test.assert(lis3dh.range_of_ctrl4(0x10) == AccelRange4g)
    test.assert(lis3dh.range_of_ctrl4(0x20) == AccelRange8g)
    test.assert(lis3dh.range_of_ctrl4(0x38) == AccelRange16g)
    test.assert_eq(lis3dh.fs_of_range(AccelRange2g), 0)
    test.assert_eq(lis3dh.fs_of_range(AccelRange4g), 1)
    test.assert_eq(lis3dh.fs_of_range(AccelRange8g), 2)
    test.assert_eq(lis3dh.fs_of_range(AccelRange16g), 3)

@test
fn test_the_mode_follows_lpen_and_hr() [io, hw]
    test.assert(lis3dh.mode_of(0x00, 0x08) == Lis3dhMode.Lis3dhHighRes)
    test.assert(lis3dh.mode_of(0x00, 0x00) == Lis3dhMode.Lis3dhNormal)
    test.assert(lis3dh.mode_of(0x08, 0x00) == Lis3dhMode.Lis3dhLowPower)
    test.assert(lis3dh.mode_of(0x08, 0x08) == Lis3dhMode.Lis3dhLowPower)
    test.assert_eq(lis3dh.shift_of(Lis3dhMode.Lis3dhHighRes), 4)
    test.assert_eq(lis3dh.shift_of(Lis3dhMode.Lis3dhNormal), 6)
    test.assert_eq(lis3dh.shift_of(Lis3dhMode.Lis3dhLowPower), 8)

@test
fn test_the_step_is_the_data_sheet_figure_in_each_mode() [io, hw]
    test.assert_eq(lis3dh.ug_per_count(AccelRange2g, Lis3dhMode.Lis3dhHighRes), 1000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange4g, Lis3dhMode.Lis3dhHighRes), 2000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange8g, Lis3dhMode.Lis3dhHighRes), 4000)
    // The ±16 g step is 12 mg, not 16 g over 2^11.
    test.assert_eq(lis3dh.ug_per_count(AccelRange16g, Lis3dhMode.Lis3dhHighRes), 12000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange2g, Lis3dhMode.Lis3dhNormal), 4000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange16g, Lis3dhMode.Lis3dhNormal), 48000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange2g, Lis3dhMode.Lis3dhLowPower), 16000)
    test.assert_eq(lis3dh.ug_per_count(AccelRange16g, Lis3dhMode.Lis3dhLowPower), 192000)

@test
fn test_the_rate_codes() [io, hw]
    test.assert_eq(lis3dh.rate_of_ctrl1(0x07), 0)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x17), 1)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x27), 10)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x37), 25)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x47), 50)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x57), 100)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x67), 200)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x77), 400)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x8F), 1620)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x97), 1344)
    test.assert_eq(lis3dh.rate_of_ctrl1(0x9F), 5376)
    // Codes 1010 to 1111 are reserved.
    test.assert_eq(lis3dh.rate_of_ctrl1(0xA7), 0)

@test
fn test_a_requested_rate_rounds_up_within_the_mode() [io, hw]
    let hr = Lis3dhMode.Lis3dhHighRes
    let lp = Lis3dhMode.Lis3dhLowPower
    test.assert_eq(lis3dh.odr_for_rate(0, hr), 1)
    test.assert_eq(lis3dh.odr_for_rate(1, hr), 1)
    test.assert_eq(lis3dh.odr_for_rate(2, hr), 2)
    test.assert_eq(lis3dh.odr_for_rate(10, hr), 2)
    test.assert_eq(lis3dh.odr_for_rate(11, hr), 3)
    test.assert_eq(lis3dh.odr_for_rate(25, hr), 3)
    test.assert_eq(lis3dh.odr_for_rate(26, hr), 4)
    test.assert_eq(lis3dh.odr_for_rate(50, hr), 4)
    test.assert_eq(lis3dh.odr_for_rate(51, hr), 5)
    test.assert_eq(lis3dh.odr_for_rate(100, hr), 5)
    test.assert_eq(lis3dh.odr_for_rate(101, hr), 6)
    test.assert_eq(lis3dh.odr_for_rate(200, hr), 6)
    test.assert_eq(lis3dh.odr_for_rate(201, hr), 7)
    test.assert_eq(lis3dh.odr_for_rate(400, hr), 7)
    // 1.6 kHz is low-power mode only.
    test.assert_eq(lis3dh.odr_for_rate(401, hr), 9)
    test.assert_eq(lis3dh.odr_for_rate(1620, hr), 9)
    test.assert_eq(lis3dh.odr_for_rate(401, lp), 8)
    test.assert_eq(lis3dh.odr_for_rate(1620, lp), 8)
    test.assert_eq(lis3dh.odr_for_rate(1621, lp), 9)
    test.assert_eq(lis3dh.odr_for_rate(99999, lp), 9)

// ── Samples ──────────────────────────────────────────────────────────

@test
fn test_a_sample_in_high_resolution_is_converted_at_the_range_it_was_taken_in() [io, hw]
    let c = chip()
    // High resolution, ±2 g, 100 Hz.
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x88)
    put_hr(c, 1000, -500, 0)
    let d = i2c_dut(c)
    let s = lis3dh.sample_read(d)
    test.assert_eq(x_of(s), 1000)
    test.assert_eq(y_of(s), -500)
    test.assert_eq(z_of(s), 0)
    // The one burst of fourteen registers from CTRL_REG1.
    log_is(c, [2, 0x18, 0xA0, 14, -1])
    // The same count at ±16 g is twelve times as much.
    c.regs.insert(0x23, 0xB8)
    put_hr(c, 100, 0, -100)
    let t = lis3dh.sample_read(d)
    test.assert_eq(x_of(t), 1200)
    test.assert_eq(z_of(t), -1200)

@test
fn test_a_sample_in_normal_mode_is_ten_bits_and_in_low_power_eight() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // Normal mode, ±2 g: a 10-bit count of 250 is 1000 mg.
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x80)
    put16(c, 0x28, 250 * 64)
    put16(c, 0x2A, -250 * 64)
    put16(c, 0x2C, 1 * 64)
    let n = lis3dh.sample_read(d)
    test.assert_eq(x_of(n), 1000)
    test.assert_eq(y_of(n), -1000)
    test.assert_eq(z_of(n), 4)
    // Low-power mode, ±4 g: an 8-bit count of 31 is 31 times 32 mg.
    c.regs.insert(0x20, 0x5F)
    c.regs.insert(0x23, 0x90)
    put16(c, 0x28, 31 * 256)
    put16(c, 0x2A, -1 * 256)
    put16(c, 0x2C, 0)
    let l = lis3dh.sample_read(d)
    test.assert_eq(x_of(l), 992)
    test.assert_eq(y_of(l), -32)

@test
fn test_a_sample_over_spi_is_the_same_burst() [io, hw]
    let c = chip()
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x88)
    put_hr(c, 10, 20, 30)
    let s = lis3dh.sample_read(spi_dut(c))
    test.assert_eq(x_of(s), 10)
    test.assert_eq(y_of(s), 20)
    test.assert_eq(z_of(s), 30)
    log_is(c, spi_read_log(0xE0, 14))

@test
fn test_no_part_gives_no_sample_and_is_never_ready() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    test.assert(lis3dh.sample_read(i2c_dut(c)) == None)
    test.assert(not lis3dh.sample_ready(i2c_dut(c)))

@test
fn test_ready_is_the_zyxda_flag() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x27, 0x07)
    test.assert(not lis3dh.sample_ready(d))
    c.regs.insert(0x27, 0x08)
    test.assert(lis3dh.sample_ready(d))
    // An overrun bit with ZYXDA clear is not a new sample.
    c.regs.insert(0x27, 0x80)
    test.assert(not lis3dh.sample_ready(d))

// ── Range, mode and rate ─────────────────────────────────────────────

@test
fn test_the_range_is_written_without_touching_the_other_bits_of_ctrl_reg4() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x23, 0x88)
    test.assert(lis3dh.range_write(d, AccelRange8g))
    test.assert_eq(reg_of(c, 0x23), 0xA8)
    test.assert(lis3dh.range_read(d) == AccelRange8g)
    test.assert(lis3dh.range_write(d, AccelRange2g))
    test.assert_eq(reg_of(c, 0x23), 0x88)
    c.st.insert(4, 0)
    test.assert(not lis3dh.range_write(d, AccelRange4g))
    test.assert(lis3dh.range_read(d) == AccelRange2g)

@test
fn test_an_update_changes_only_the_bits_of_its_mask() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x24, 0x0C)
    test.assert(lis3dh.reg_update(d, 0x24, 0x40, 0x40))
    test.assert_eq(reg_of(c, 0x24), 0x4C)
    test.assert(lis3dh.reg_update(d, 0x24, 0x04, 0x00))
    test.assert_eq(reg_of(c, 0x24), 0x48)
    // Bits outside the mask are not taken from the new value.
    test.assert(lis3dh.reg_update(d, 0x24, 0x08, 0xFF))
    test.assert_eq(reg_of(c, 0x24), 0x48)
    c.st.insert(4, 0)
    test.assert(not lis3dh.reg_update(d, 0x24, 0x40, 0x40))

@test
fn test_a_register_that_ignores_the_write_is_not_taken() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.ro.insert(0x23, 1)
    test.assert(not lis3dh.range_write(d, AccelRange16g))
    test.assert(not lis3dh.reg_write(d, 0x23, 0x30))
    c.ro.insert(0x20, 1)
    test.assert_eq(lis3dh.rate_write(d, 100), 0)

@test
fn test_the_rate_is_written_with_the_axes_on_and_lpen_kept() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lis3dh.rate_write(d, 100), 100)
    test.assert_eq(reg_of(c, 0x20), 0x57)
    test.assert_eq(lis3dh.rate_read(d), 100)
    test.assert_eq(lis3dh.rate_write(d, 30), 50)
    test.assert_eq(reg_of(c, 0x20), 0x47)
    // In low-power mode 500 Hz is 1.6 kHz; elsewhere it is 1.344 kHz.
    c.regs.insert(0x20, 0x4F)
    test.assert_eq(lis3dh.rate_write(d, 500), 1620)
    test.assert_eq(reg_of(c, 0x20), 0x8F)
    test.assert_eq(lis3dh.rate_write(d, 5000), 5376)
    c.regs.insert(0x20, 0x47)
    test.assert_eq(lis3dh.rate_write(d, 500), 1344)
    c.st.insert(4, 0)
    test.assert_eq(lis3dh.rate_write(d, 100), 0)
    test.assert_eq(lis3dh.rate_read(d), 0)

@test
fn test_the_mode_changes_clear_the_bit_being_left_before_setting_the_new_one() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x88)
    test.assert(lis3dh.mode_read(d) == Lis3dhMode.Lis3dhHighRes)
    log_clear(c)
    // High resolution to low power: HR goes first, then LPen.
    test.assert(lis3dh.mode_write(d, Lis3dhMode.Lis3dhLowPower))
    test.assert_eq(reg_of(c, 0x23), 0x80)
    test.assert_eq(reg_of(c, 0x20), 0x5F)
    test.assert(lis3dh.mode_read(d) == Lis3dhMode.Lis3dhLowPower)
    // Low power to high resolution: LPen goes before HR is set.
    log_clear(c)
    test.assert(lis3dh.mode_write(d, Lis3dhMode.Lis3dhHighRes))
    log_is(c, [2, 0x18, 0x20, 1, -1, 2, 0x18, 0x23, 1, -1,
               1, 0x18, 0x23, 0x80, -1, 2, 0x18, 0x23, 1, -1,
               1, 0x18, 0x20, 0x57, -1, 2, 0x18, 0x20, 1, -1,
               1, 0x18, 0x23, 0x88, -1, 2, 0x18, 0x23, 1, -1])
    test.assert(lis3dh.mode_read(d) == Lis3dhMode.Lis3dhHighRes)
    test.assert(lis3dh.mode_write(d, Lis3dhMode.Lis3dhNormal))
    test.assert_eq(reg_of(c, 0x23), 0x80)
    test.assert_eq(reg_of(c, 0x20), 0x57)

@test
fn test_leaving_low_power_moves_the_1_6_khz_code_to_1_344_khz() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x20, 0x8F)
    c.regs.insert(0x23, 0x80)
    test.assert(lis3dh.mode_write(d, Lis3dhMode.Lis3dhNormal))
    test.assert_eq(reg_of(c, 0x20), 0x97)
    test.assert_eq(lis3dh.rate_read(d), 1344)

@test
fn test_a_mode_change_on_a_silent_or_stubborn_part_fails() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.st.insert(4, 0)
    test.assert(not lis3dh.mode_write(d, Lis3dhMode.Lis3dhNormal))
    test.assert(lis3dh.mode_read(d) == Lis3dhMode.Lis3dhHighRes)
    c.st.insert(4, 1)
    c.ro.insert(0x20, 1)
    test.assert(not lis3dh.mode_write(d, Lis3dhMode.Lis3dhLowPower))
    // CTRL_REG4 refuses its first write, which clears HR.
    let e = chip()
    let f = i2c_dut(e)
    e.regs.insert(0x23, 0x88)
    e.ro.insert(0x23, 1)
    test.assert(not lis3dh.mode_write(f, Lis3dhMode.Lis3dhNormal))
    // The part answers the first read and not the second.
    let g = chip()
    let h = QuietAfter { inner: i2c_dut(g), left: counter(1) }
    test.assert(not lis3dh.mode_write(h, Lis3dhMode.Lis3dhNormal))

// ── Bring-up ─────────────────────────────────────────────────────────

@test
fn test_the_bring_up_writes_its_settings_on_i2c() [io, hw]
    let c = chip()
    c.regs.insert(0x24, 0x40)
    c.regs.insert(0x2E, 0x8F)
    let d = i2c_dut(c)
    test.assert(lis3dh.start(d))
    test.assert_eq(reg_of(c, 0x20), 0x57)
    test.assert_eq(reg_of(c, 0x21), 0x00)
    test.assert_eq(reg_of(c, 0x22), 0x10)
    test.assert_eq(reg_of(c, 0x23), 0x88)
    // The FIFO a previous program left on is off, and in bypass.
    test.assert_eq(reg_of(c, 0x24), 0x00)
    test.assert_eq(reg_of(c, 0x25), 0x00)
    test.assert_eq(reg_of(c, 0x2E), 0x00)
    test.assert_eq(reg_of(c, 0x1F), 0x00)
    test.assert_eq(at(c.st, 22), 400000)
    test.assert(lis3dh.rate_read(d) == 100)

@test
fn test_the_bring_up_over_spi_runs_the_same_settings() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(lis3dh.start(d))
    test.assert_eq(reg_of(c, 0x20), 0x57)
    test.assert_eq(reg_of(c, 0x22), 0x10)
    test.assert_eq(reg_of(c, 0x23), 0x88)
    test.assert_eq(at(c.st, 21), 3)

@test
fn test_the_bring_up_puts_the_part_in_power_down_before_it_sets_the_rest() [io, hw]
    let c = chip()
    c.regs.insert(0x20, 0x97)
    let d = i2c_dut(c)
    test.assert(lis3dh.start(d))
    // After WHO_AM_I, the first write is CTRL_REG1 at power-down.
    test.assert_eq(at(c.log, 0), 2)
    test.assert_eq(at(c.log, 2), 0x0F)
    test.assert_eq(at(c.log, 5), 1)
    test.assert_eq(at(c.log, 7), 0x20)
    test.assert_eq(at(c.log, 8), 0x07)

@test
fn test_a_part_that_is_not_a_lis3dh_is_refused() [io, hw]
    let c = chip()
    c.regs.insert(0x0F, 0x32)
    test.assert(not lis3dh.start(i2c_dut(c)))
    test.assert_eq(reg_of(c, 0x20), 0x07)
    let e = chip()
    e.st.insert(4, 0)
    test.assert(not lis3dh.start(spi_dut(e)))

@test
fn test_a_part_that_refuses_a_setting_ends_the_bring_up() [io, hw]
    let c = chip()
    c.ro.insert(0x23, 1)
    test.assert(not lis3dh.start(i2c_dut(c)))
    test.assert_eq(reg_of(c, 0x20), 0x07)

// ── The FIFO ─────────────────────────────────────────────────────────

@test
fn test_the_fifo_starts_in_stream_mode_and_writes_the_mode_before_the_enable() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x22, 0x10)
    test.assert(lis3dh.fifo_start(d, 20))
    test.assert_eq(reg_of(c, 0x2E), 0x94)
    test.assert_eq(reg_of(c, 0x24), 0x40)
    // The watermark replaces the data-ready on INT1.
    test.assert_eq(reg_of(c, 0x22), 0x04)
    // FIFO_CTRL_REG is written before FIFO_EN is set.
    test.assert_eq(at(c.log, 0), 1)
    test.assert_eq(at(c.log, 2), 0x2E)
    test.assert(lis3dh.fifo_start(d, 0))
    test.assert_eq(reg_of(c, 0x2E), 0x81)
    test.assert(lis3dh.fifo_start(d, 99))
    test.assert_eq(reg_of(c, 0x2E), 0x9F)

@test
fn test_the_fifo_stops_in_bypass_before_the_enable_clears() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x24, 0x48)
    c.regs.insert(0x2E, 0x94)
    c.regs.insert(0x22, 0x04)
    test.assert(lis3dh.fifo_stop(d))
    test.assert_eq(reg_of(c, 0x2E), 0x00)
    // Only FIFO_EN clears; the latch bit stays.
    test.assert_eq(reg_of(c, 0x24), 0x08)
    test.assert_eq(reg_of(c, 0x22), 0x10)
    test.assert_eq(at(c.log, 2), 0x2E)

@test
fn test_a_silent_part_does_not_start_or_stop_a_fifo() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    test.assert(not lis3dh.fifo_start(i2c_dut(c), 10))
    test.assert(not lis3dh.fifo_stop(i2c_dut(c)))
    test.assert_eq(lis3dh.fifo_count(i2c_dut(c)), 0)

@test
fn test_the_fifo_count_is_fss_with_a_full_fifo_reading_as_32() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lis3dh.fifo_count(d), 0)
    fifo_push(c, 1, 2, 3)
    fifo_push(c, 4, 5, 6)
    fifo_push(c, 7, 8, 9)
    test.assert_eq(lis3dh.fifo_count(d), 3)
    for _i in 0..29
        fifo_push(c, 0, 0, 0)
    test.assert_eq(lis3dh.fifo_count(d), 32)
    test.assert_eq(lis3dh.fifo_count(spi_dut(c)), 32)

@test
fn test_the_fifo_drains_oldest_first_at_the_modes_resolution() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x88)
    c.regs.insert(0x24, 0x40)
    c.regs.insert(0x2E, 0x94)
    fifo_push(c, 100, 200, 300)
    fifo_push(c, -100, -200, -300)
    fifo_push(c, 1, 2, 3)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(d, var out), 3)
    test.assert_eq(out.len(), 3)
    test.assert_eq(out[0].x, 100)
    test.assert_eq(out[0].z, 300)
    test.assert_eq(out[1].y, -200)
    test.assert_eq(out[2].x, 1)
    test.assert_eq(lis3dh.fifo_count(d), 0)
    // The destination is emptied first, and an empty FIFO moves nothing.
    test.assert_eq(lis3dh.fifo_read(d, var out), 0)
    test.assert_eq(out.len(), 0)

@test
fn test_the_fifo_read_through_the_trait_over_spi() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0xB8)
    c.regs.insert(0x24, 0x40)
    c.regs.insert(0x2E, 0x94)
    fifo_push(c, 10, -10, 0)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(d, var out), 1)
    // ±16 g: 12 mg a count.
    test.assert_eq(out[0].x, 120)
    test.assert_eq(out[0].y, -120)

@test
fn test_a_part_that_goes_quiet_mid_drain_ends_the_drain() [io, hw]
    let c = chip()
    c.regs.insert(0x20, 0x57)
    c.regs.insert(0x23, 0x88)
    c.regs.insert(0x24, 0x40)
    c.regs.insert(0x2E, 0x94)
    fifo_push(c, 1, 1, 1)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(i2c_dut(c), var out), 1)
    // The part answers `left` reads and then none: the count, then the
    // mode, then each sample.
    var out1: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(QuietAfter { inner: i2c_dut(fifo_of_two()), left: counter(1) }, var out1), 0)
    var out2: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(QuietAfter { inner: i2c_dut(fifo_of_two()), left: counter(2) }, var out2), 0)
    var out3: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lis3dh.fifo_read(QuietAfter { inner: i2c_dut(fifo_of_two()), left: counter(3) }, var out3), 1)
    test.assert_eq(out3.len(), 1)

// A part with the FIFO on and two samples in it.
fn fifo_of_two() -> Chip
    let e = chip()
    e.regs.insert(0x20, 0x57)
    e.regs.insert(0x23, 0x88)
    e.regs.insert(0x24, 0x40)
    e.regs.insert(0x2E, 0x94)
    fifo_push(e, 1, 1, 1)
    fifo_push(e, 2, 2, 2)
    e

// A map holding `n` under key 0.
fn counter(n: Int) -> HashMap<Int, Int>
    let m: HashMap<Int, Int> = HashMap.new()
    m.insert(0, n)
    m

// A port that answers `left` reads and then none, over another port.
struct QuietAfter
    inner: I2cDut
    left: HashMap<Int, Int>

impl Lis3dhPort for QuietAfter
    fn setup(self) -> Bool [hw]
        self.inner.setup()

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        if at(self.left, 0) <= 0
            dst.clear()
            return false
        self.left.insert(0, at(self.left, 0) - 1)
        self.inner.read_regs(reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        self.inner.write_reg(reg, v)

    fn irq_level(self) -> Int [hw]
        self.inner.irq_level()

// ── Self-test ────────────────────────────────────────────────────────

@test
fn test_the_self_test_change_is_the_difference_between_the_two_readings() [io, hw]
    let c = chip()
    c.st.insert(30, 276)
    c.st.insert(31, 276)
    c.st.insert(32, 984)
    c.regs.insert(0x27, 0x08)
    put_hr(c, 10, 20, 1000)
    c.regs.insert(0x20, 0x77)
    c.regs.insert(0x23, 0xB8)
    let d = i2c_dut(c)
    let up = lis3dh.self_test_delta(d, false)
    test.assert_eq(x_of(up), 276)
    test.assert_eq(y_of(up), 276)
    test.assert_eq(z_of(up), 984)
    let down = lis3dh.self_test_delta(d, true)
    test.assert_eq(x_of(down), -276)
    test.assert_eq(z_of(down), -984)
    // The settings the part had come back: 400 Hz, ±16 g, ST clear.
    test.assert_eq(reg_of(c, 0x20), 0x77)
    test.assert_eq(reg_of(c, 0x23), 0xB8)

@test
fn test_the_self_test_sets_st_01_for_the_positive_change_and_10_for_the_negative() [io, hw]
    let c = chip()
    c.regs.insert(0x27, 0x08)
    let d = spi_dut(c)
    let _a = lis3dh.self_test_delta(d, false)
    let _b = lis3dh.self_test_delta(d, true)
    // The writes to CTRL_REG4 in the log, by their data byte.
    var up = false
    var down = false
    var i = 0
    while i + 3 < at(c.st, 99)
        if at(c.log, i) == 3 and at(c.log, i + 1) == 0x23 and at(c.log, i + 3) == -1
            if at(c.log, i + 2) == 0x8A
                up = true
            if at(c.log, i + 2) == 0x8C
                down = true
        i = i + 1
    test.assert(up)
    test.assert(down)

@test
fn test_a_self_test_with_no_data_ready_gives_nothing_and_restores_the_settings() [io, hw]
    let c = chip()
    c.regs.insert(0x20, 0x47)
    c.regs.insert(0x23, 0x90)
    let d = i2c_dut(c)
    test.assert(lis3dh.self_test_delta(d, false) == None)
    test.assert_eq(reg_of(c, 0x20), 0x47)
    test.assert_eq(reg_of(c, 0x23), 0x90)

@test
fn test_a_self_test_that_loses_the_second_sample_gives_nothing() [io, hw]
    let c = chip()
    c.regs.insert(0x27, 0x08)
    let d = i2c_dut(c)
    // The sample is ready twice for the reading without the test and once
    // for the first of the other, then never.
    let g = FlagAfter { inner: d, ready: counter(3) }
    test.assert(lis3dh.self_test_delta(g, false) == None)
    let h = FlagAfter { inner: d, ready: counter(1) }
    test.assert(lis3dh.self_test_delta(h, false) == None)

// A port whose STATUS_REG reads ready `ready` times and then not, over
// another port; the self-test polls it.
struct FlagAfter
    inner: I2cDut
    ready: HashMap<Int, Int>

impl Lis3dhPort for FlagAfter
    fn setup(self) -> Bool [hw]
        self.inner.setup()

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        let ok = self.inner.read_regs(reg, n, var dst)
        if reg == 0x27 and n == 1
            if at(self.ready, 0) > 0
                self.ready.insert(0, at(self.ready, 0) - 1)
            else
                dst.clear()
                let _ = dst.push(0 as u8)
        ok

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        self.inner.write_reg(reg, v)

    fn irq_level(self) -> Int [hw]
        self.inner.irq_level()

@test
fn test_a_self_test_on_a_silent_part_gives_nothing() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    test.assert(lis3dh.self_test_delta(i2c_dut(c), false) == None)
    let e = chip()
    e.ro.insert(0x23, 1)
    e.regs.insert(0x27, 0x08)
    test.assert(lis3dh.self_test_delta(i2c_dut(e), false) == None)
    let f = chip()
    f.st.insert(4, 1)
    f.regs.insert(0x27, 0x08)
    f.ro.insert(0x20, 1)
    test.assert(lis3dh.self_test_delta(i2c_dut(f), false) == None)

@test
fn test_the_self_test_window() [io, hw]
    let ok = AccelMilliG { x: 276, y: -276, z: 984 }
    test.assert(lis3dh.self_test_within(ok, 17, 1000))
    test.assert(not lis3dh.self_test_within(ok, 17, 500))
    test.assert(not lis3dh.self_test_within(AccelMilliG { x: 10, y: 300, z: 300 }, 17, 1000))
    test.assert(not lis3dh.self_test_within(AccelMilliG { x: 300, y: 5, z: 300 }, 17, 1000))
    test.assert(not lis3dh.self_test_within(AccelMilliG { x: 300, y: 300, z: -2000 }, 17, 1000))

// ── The types over the host's board handles ──────────────────────────
//
// The host's handles are absent hardware: every transfer is refused, so
// each method answers its "no part" value.  This runs the lines of the
// two types that forward to the functions above.

@test
fn test_the_i2c_type_over_absent_hardware() [io, hw]
    let w = dev_bus.wiring_i2c(0, 0x18)
    let p = Lis3dh.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x0F) == None)
    test.assert(not p.set_reg(0x20, 1))
    test.assert(p.mode() == Lis3dhMode.Lis3dhHighRes)
    test.assert(not p.set_mode(Lis3dhMode.Lis3dhNormal))
    test.assert(not p.fifo_begin(10))
    test.assert(not p.fifo_end())
    test.assert(p.self_test(false) == None)
    test.assert_eq(p.irq_level(), -1)
    test.assert(p.accel_read() == None)
    test.assert(not p.accel_ready())
    test.assert(p.accel_range() == AccelRange2g)
    test.assert(not p.accel_set_range(AccelRange4g))
    test.assert_eq(p.accel_rate_hz(), 0)
    test.assert_eq(p.accel_set_rate_hz(100), 0)
    test.assert_eq(p.accel_fifo_count(), 0)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(p.accel_fifo_read(var out), 0)
    test.assert(p.device_id() == None)

@test
fn test_the_spi_type_over_absent_hardware() [io, hw]
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    let p = Lis3dhSpi.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not p.begin())
    test.assert(p.reg(0x0F) == None)
    test.assert(not p.set_reg(0x20, 1))
    test.assert(p.mode() == Lis3dhMode.Lis3dhHighRes)
    test.assert(not p.set_mode(Lis3dhMode.Lis3dhNormal))
    test.assert(not p.fifo_begin(10))
    test.assert(not p.fifo_end())
    test.assert(p.self_test(true) == None)
    test.assert_eq(p.irq_level(), -1)
    test.assert(p.accel_read() == None)
    test.assert(not p.accel_ready())
    test.assert(p.accel_range() == AccelRange2g)
    test.assert(not p.accel_set_range(AccelRange4g))
    test.assert_eq(p.accel_rate_hz(), 0)
    test.assert_eq(p.accel_set_rate_hz(100), 0)
    test.assert_eq(p.accel_fifo_count(), 0)
    var out: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(p.accel_fifo_read(var out), 0)
    test.assert(p.device_id() == None)
